{
  "hosting": {
    "public": "admin_dashboard",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "SETUP_GUIDE.md",
      "**/*.example"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff"   }
        ]
      }
    ],
    "rewrites": [
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/login",     "destination": "/index.html"     }
    ]
  }
}
